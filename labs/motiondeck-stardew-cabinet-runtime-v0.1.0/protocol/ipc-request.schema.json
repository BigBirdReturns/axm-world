{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.invalid/schemas/motiondeck-cabinet-ipc-request-1.json",
  "title": "MotionDeck Cabinet Runtime IPC Request",
  "type": "object",
  "required": ["format", "requestId", "client", "auth", "operation", "sentAt", "payload"],
  "properties": {
    "format": { "const": "motiondeck-cabinet-ipc-request/1" },
    "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "client": {
      "type": "object",
      "required": ["id", "role", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "role": { "enum": ["adapter", "operator", "test"] },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 }
      },
      "additionalProperties": false
    },
    "auth": {
      "type": "object",
      "required": ["token"],
      "properties": { "token": { "type": "string", "minLength": 32, "maxLength": 256 } },
      "additionalProperties": false
    },
    "operation": {
      "enum": ["hello", "probe", "arm", "heartbeat", "disarm", "recenter", "select-fallback", "capture-frame", "renderer-mode", "drain-events", "shutdown"]
    },
    "transactionId": { "type": ["string", "null"], "maxLength": 128 },
    "sentAt": { "type": "string", "format": "date-time" },
    "payload": { "type": "object" }
  },
  "additionalProperties": false
}
