{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.tools/schemas/rodoh-one-am-structural-evidence-v1.schema.json",
  "title": "RODOH one-a.m. structural evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "candidate", "contractId", "startedAt", "completedAt", "authority", "events", "objectives", "route", "continuation", "recoveries"],
  "properties": {
    "format": { "const": "rodoh-one-am-structural-evidence/1" },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "authoredIdentity", "experienceId"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "authoredIdentity": { "type": "string", "minLength": 1 },
        "experienceId": { "type": "string", "minLength": 1 }
      }
    },
    "contractId": { "type": "string", "minLength": 1 },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "acceptedResultFormat", "acceptedResultId", "campaignEffectCommitted"],
      "properties": {
        "owner": { "const": "Arc" },
        "acceptedResultFormat": { "type": ["string", "null"] },
        "acceptedResultId": { "type": ["string", "null"] },
        "campaignEffectCommitted": { "type": "boolean" }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/event" }
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "authoredVerb", "mechanicPerformed", "observableStateChange"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "authoredVerb": { "type": "string", "minLength": 1 },
          "mechanicPerformed": { "type": "string", "minLength": 1 },
          "observableStateChange": { "type": "string", "minLength": 1 }
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["choiceId", "runtimeDeltaEventIds"],
      "properties": {
        "choiceId": { "type": ["string", "null"] },
        "runtimeDeltaEventIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "continuation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["persistentStateChanged", "playableSuccessorId"],
      "properties": {
        "persistentStateChanged": { "type": "boolean" },
        "playableSuccessorId": { "type": ["string", "null"] }
      }
    },
    "recoveries": {
      "type": "array",
      "items": { "$ref": "#/$defs/recovery" }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "atMs", "kind", "description"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "atMs": { "type": "number", "minimum": 0 },
        "kind": {
          "enum": [
            "identity-visible",
            "goal-visible",
            "stakes-visible",
            "action-prompt",
            "meaningful-success",
            "objective-interaction",
            "critical-reveal",
            "choice-delta",
            "result",
            "accepted-consequence",
            "world-change",
            "relationship-change",
            "successor-playable",
            "failure",
            "control-restored"
          ]
        },
        "objectiveId": { "type": "string", "minLength": 1 },
        "choiceId": { "type": "string", "minLength": 1 },
        "revealId": { "type": "string", "minLength": 1 },
        "interactionKinds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failureEventId", "controlRestoredEventId", "completedObjectiveIdsBefore", "completedObjectiveIdsAfter", "expositionReplayed"],
      "properties": {
        "failureEventId": { "type": "string", "minLength": 1 },
        "controlRestoredEventId": { "type": "string", "minLength": 1 },
        "completedObjectiveIdsBefore": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "completedObjectiveIdsAfter": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "expositionReplayed": { "type": "boolean" }
      }
    }
  }
}
