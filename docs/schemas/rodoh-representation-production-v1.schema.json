{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.tools/schemas/rodoh-representation-production-v1.schema.json",
  "title": "RODOH representation production coverage v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "planId", "status", "productionAssetIds", "sources"],
  "properties": {
    "format": { "const": "rodoh-representation-production/1" },
    "planId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["prototype", "mixed", "complete"] },
    "productionAssetIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "assetIds", "sourcePaths", "mediaType", "sha256"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "assetIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "sourcePaths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "mediaType": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
